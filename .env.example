# Copy this file to .env for local use. Never commit .env or real secrets.

# Compose/runtime configuration.
PULSE_DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse?sslmode=disable
PULSE_HTTP_ADDR=:8080
PULSE_ROLES=web,scheduler,worker,effect-worker
PULSE_MASTER_KEY=
PULSE_WEB_DIR=/web
PULSE_IMPORT_ROOTS=/data/imports
PULSE_EMBEDDING_PROVIDER=disabled
PULSE_EMBEDDING_BASE_URL=http://127.0.0.1:11434
PULSE_EMBEDDING_MODEL=qwen3-embedding

# AI is disabled by default. For DeepSeek, use:
# PULSE_AI_PROVIDER=openai-compatible
# PULSE_AI_BASE_URL=https://api.deepseek.com
# PULSE_AI_API_KEY=sk-replace-me
# PULSE_AI_MODEL=deepseek-v4-flash
PULSE_AI_PROVIDER=disabled
PULSE_AI_BASE_URL=http://127.0.0.1:11434/v1
PULSE_AI_API_KEY=
PULSE_AI_HEADERS_JSON=
PULSE_AI_MODEL=qwen3:8b
PULSE_AI_TIMEOUT=2m
PULSE_AI_MAX_DIGEST_STORIES=100
PULSE_AI_MAX_ACTIVE_JOBS=4

# Host-side values used by `make dev`; these differ from container addresses.
DEV_HTTP_ADDR=127.0.0.1:8080
DEV_DATABASE_URL=postgres://pulse:pulse@127.0.0.1:54321/pulse?sslmode=disable
DEV_IMPORT_ROOTS=./imports
DEV_EMBEDDING_PROVIDER=ollama
DEV_EMBEDDING_BASE_URL=http://127.0.0.1:11434
DEV_EMBEDDING_MODEL=qwen3-embedding

# Optional backup helper settings.
PULSE_BACKUP_DIR=./backups
PULSE_BACKUP_RETENTION_DAYS=14
