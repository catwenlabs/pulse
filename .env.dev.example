# Host-side overrides for `make dev`; copy to .env.dev if needed.
PULSE_DATABASE_URL=postgres://pulse:pulse@127.0.0.1:54321/pulse?sslmode=disable
PULSE_HTTP_ADDR=127.0.0.1:8080
PULSE_IMPORT_ROOTS=./imports
PULSE_EMBEDDING_PROVIDER=ollama
PULSE_EMBEDDING_BASE_URL=http://127.0.0.1:11434
PULSE_EMBEDDING_MODEL=qwen3-embedding
